        <mxCell id="enc" value="&lt;b&gt;Neuro-kinematic encoder&amp;#160;&amp;#160;f&lt;sub&gt;&amp;#952;&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5A586E&quot;&gt;multi-band temporal conv&lt;br&gt;spatial covariance (SPD)&lt;br&gt;cross-frequency attention&lt;/font&gt;&lt;br&gt;&lt;br&gt;z = f&lt;sub&gt;&amp;#952;&lt;/sub&gt;(X) &amp;#8712; &amp;#8477;&lt;sup&gt;d&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.6;strokeColor=#1E1B33;fillColor=#F3F2FB;fontColor=#1E1B33;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="280" height="250" as="geometry"/></mxCell>

        <mxCell id="intent" value="&lt;b&gt;&lt;font color=&quot;#5A4AE0&quot;&gt;Intent code&amp;#160;&amp;#160;z&lt;sub&gt;i&lt;/sub&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A586E&quot;&gt;min I(z&lt;sub&gt;i&lt;/sub&gt;; M)&amp;#160;&amp;#160;via GRL + HSIC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.6;strokeColor=#5A4AE0;fillColor=#F3F2FB;fontColor=#1E1B33;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="100" width="290" height="90" as="geometry"/></mxCell>
