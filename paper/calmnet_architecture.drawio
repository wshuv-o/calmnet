<mxCell id="adv" value="&lt;b&gt;GRL adversary&lt;/b&gt; R&lt;sub&gt;i&lt;/sub&gt;&lt;br&gt;&#8466;&lt;sub&gt;adv&lt;/sub&gt; = ‖R&lt;sub&gt;i&lt;/sub&gt;(GRL z&lt;sub&gt;int&lt;/sub&gt;) &#8722; &#966;(M)‖²&lt;br&gt;+ decorr &#8466;&lt;sub&gt;dec&lt;/sub&gt; = ‖Cov(z&lt;sub&gt;int&lt;/sub&gt;, &#966;)‖²" style="rounded=1;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C0392B;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="958" y="152" width="222" height="78" as="geometry"/></mxCell>
