        <mxCell id="lsc" value="&lt;b&gt;Longitudinal self-calibration&lt;/b&gt;&lt;br&gt;&lt;br&gt;p = softmax(&amp;#8467; / T*)&lt;br&gt;&lt;font color=&quot;#5A586E&quot;&gt;q&lt;sub&gt;t+1&lt;/sub&gt; = q&lt;sub&gt;t&lt;/sub&gt; + &amp;#951;(&amp;#945; &amp;#8722; 1[y &amp;#8713; C&lt;sub&gt;t&lt;/sub&gt;])&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#5A4AE0&quot;&gt;P(y &amp;#8712; C(x)) &amp;#8805; 1 &amp;#8722; &amp;#945;&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.6;strokeColor=#1E1B33;fillColor=#F3F2FB;fontColor=#1E1B33;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="250" height="250" as="geometry"/></mxCell>

        <mxCell id="sas" value="&lt;b&gt;Safety-asymmetric selection&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5A586E&quot;&gt;threshold &amp;#964;&lt;sub&gt;c&lt;/sub&gt; per class&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B0392B&quot;&gt;P(&amp;#374;=Walk | Y=Stop) &amp;#8804; &amp;#946;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Walk / Stop / abstain&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#B0392B&quot;&gt;&amp;#8594; STOP&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.6;strokeColor=#1E1B33;fillColor=#F3F2FB;fontColor=#1E1B33;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="100" width="250" height="250" as="geometry"/></mxCell>

